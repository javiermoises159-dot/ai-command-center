# ---------------------------------------------------------------------------
# AI Command Center - server environment
# Copy to .env and adjust. This file is read by the SERVER only.
# The frontend never receives any of these values and never holds API keys.
# ---------------------------------------------------------------------------

# HTTP
PORT=3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Persistence adapter: "postgres" (default) or "memory" (ephemeral, for demos/tests)
PERSISTENCE=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_command_center
DB_POOL_MAX=10
# Run pending SQL migrations automatically on boot
DB_AUTO_MIGRATE=true
# Most hosted Postgres providers require this; local Postgres does not
DB_SSL=false

# Orchestration
# Which provider the orchestrator uses. Only "mock" is implemented today.
AI_PROVIDER=mock
AI_MODEL=mock-1
# Max agents executed concurrently by the in-process queue (missions run sequentially inside)
QUEUE_CONCURRENCY=1
# Keep executing the remaining agents when a worker agent fails
CONTINUE_ON_WORKER_FAILURE=true
# Per-agent timeout in milliseconds
AGENT_TIMEOUT_MS=60000

# MockProvider tuning (simulated latency, in ms, per agent call)
MOCK_MIN_LATENCY_MS=250
MOCK_MAX_LATENCY_MS=900

# ---------------------------------------------------------------------------
# Real AI providers (server-side only: keys never reach the browser, the
# database, the trace, the audit log or any API response).
#
# A provider is CONFIGURED only when it has both a key AND a model. There is no
# built-in default model. Without them it is "Sin configurar" and is never
# replaced by the simulation. Full guide: docs/PROVIDERS.md
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=              # one id, or a comma-separated list
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_MAX_TOKENS=4096  # output cap when a task does not set one
# GOOGLE_API_KEY=            # Google AI Studio (Gemini API) key, NOT Vertex
# GEMINI_API_KEY=            # alias for GOOGLE_API_KEY (GOOGLE_API_KEY wins)
# GEMINI_MODEL=
# Optional gateway / compatible-server overrides. A run against a custom endpoint
# is not a real end-to-end check of the vendor. (ANTHROPIC_BASE_URL is never read.)
# OPENAI_API_BASE_URL=
# ANTHROPIC_API_BASE_URL=
# GEMINI_API_BASE_URL=
# Providers the operator switches off, e.g. openai,gemini
# MADRE_DISABLED_PROVIDERS=
# Any OpenAI-compatible host (OpenRouter, Groq, Cerebras, Mistral, GitHub Models...).
# All three are needed. Example with OpenRouter free models:
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=qwen/qwen3.8-27b:free
# OPENAI_COMPAT_LABEL=OpenRouter
# More free-tier hosts, each its own provider (the router rotates between all that
# are configured and falls back when one hits its daily limit). Key AND model needed.
# Model ids age quickly: copy them from each dashboard.
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# NVIDIA_API_KEY=            # NVIDIA NIM (build.nvidia.com)
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# More free AI backups for text (used when another one runs out of quota):
# OPENROUTER_API_KEY=       # openrouter.ai — models whose id ends in ":free"
# OPENROUTER_MODEL=
# SAMBANOVA_API_KEY=        # cloud.sambanova.ai (free plan)
# SAMBANOVA_MODEL=
# Backups for pictures and transcription (all optional):
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # uses the Gemini key already set
# HF_TOKEN=                 # huggingface.co free token: FLUX pictures on another quota
# GROQ_API_KEY=             # Groq Whisper as backup transcription (reused from OPENAI_COMPAT_* when that is Groq)
# IMAGE_FALLBACK_FREE=on    # Pollinations pictures, no key; set to off to disable
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# Voice-overs in the content calendar reuse the Gemini key; override the speech model if it is retired:
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# These three are assumed free (0 USD). If you move to a paid plan, price them in MADRE_PRICES_JSON.
# Tools (free): web search via Tavily's free plan; Wikipedia needs no key.
# TAVILY_API_KEY=
# WIKIPEDIA_ENABLED=true   # default true in production, false elsewhere
# MADRE_BALANCE_PROVIDERS=true   # alternate between equally good providers (default true in production)
# NEWS_ENABLED=true          # recent news headlines from GDELT (free, no key); default true in production
# WEB_FETCH_ENABLED=true    # reads public pages (blocks private networks); web.search also reads its top 2 results

# ---------------------------------------------------------------------------
# MADRE (mission engine)
# ---------------------------------------------------------------------------
# Engine for new missions: "madre" (compile -> plan -> route -> execute -> QA) or
# "classic" (the fixed eight-agent pipeline). A request can override it with "mode".
DEFAULT_MISSION_MODE=madre
# Local Ollama server. Unset means Ollama is NOT CONNECTED (no request is ever made).
# OLLAMA_BASE_URL=http://localhost:11434
# Steps that may run at the same time, and QA revision rounds per stage
MADRE_PARALLELISM=2
MADRE_MAX_REVISION_ROUNDS=2
# Spending limits in USD. Unset means no limit. When a limit is set and a model's
# price is unknown, MADRE refuses the external call instead of guessing.
# MADRE_BUDGET_PER_MISSION_USD=1
# MADRE_BUDGET_DAILY_USD=5
# MADRE_BUDGET_MONTHLY_USD=50
# What to do at a limit: block | fallback_local | ask
MADRE_BUDGET_ON_EXCEED=block
# Prices per 1k tokens you have confirmed with the vendor (MADRE never guesses):
# Prices per 1k tokens, keyed "provider" or "provider:model". Set these from the vendor's
# current price list; MADRE never guesses one (unknown price + a budget = refused).
# MADRE_PRICES_JSON={"openai:MODEL":{"inputPer1kUsd":0.0,"outputPer1kUsd":0.0}}

# --- Publish finished websites for free (GitHub Pages) ------------------------
# Create ONE public repository (e.g. acc-sites) with Pages on, and a fine-grained
# token limited to that repository: Contents = Read and write, Pages = Read and write.
# Each site goes to <repo>/<folder>/index.html. Publishing only happens when a person taps "Publicar".
# GITHUB_TOKEN=
# GITHUB_SITES_REPO=owner/acc-sites

# --- Guard rails -------------------------------------------------------------
# Not a security control: an in-process ceiling that stops a runaway client
# (a stuck polling loop, a retry storm) from saturating the API. The default is
# far above what the app itself needs. There is no authentication yet, so there
# is no per-account quota — see docs/MADRE.md, "Producción".
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# Warn once spending passes this share of any limit. 0 switches the warning off
# without switching the limits off.
MADRE_BUDGET_ALERT_AT_PERCENT=80
# Per-tool ceilings in USD, if you want one. MADRE never invents a price.
# MADRE_TOOL_BUDGETS_JSON={"web.search":2.5}

# Real publishing (each piece is published only when the person taps its button):
# TELEGRAM_BOT_TOKEN=       # from @BotFather
# TELEGRAM_CHAT_ID=         # @yourchannel (public channel) or the numeric chat id; the bot must be an admin
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN=      # a Page access token with pages_manage_posts

# Pool mode (default on): all real AIs share the work by turns with no fixed roles, a failing
# or out-of-quota one hands the step to the next, and a spent free quota rests 3 h and returns.
# MADRE_POOL_MODE=true
# MADRE_PARALLELISM=3
