{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // vite/client supplies `import.meta.env` and the `*.css` module declaration;
    // node is needed by vite.config.ts, which this project also typechecks.
    "types": ["vite/client", "node"],
    "paths": {
      "@acc/contracts": ["../../packages/contracts/src/index.ts"],
      "@acc/contracts/*": ["../../packages/contracts/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
