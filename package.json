{
  "name": "ai-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "test": "tsx --test \"packages/**/*.test.ts\" \"apps/server/**/*.test.ts\" \"apps/web/src/**/*.test.ts\"",
    "test:watch": "tsx --test --watch \"packages/**/*.test.ts\" \"apps/server/**/*.test.ts\" \"apps/web/src/**/*.test.ts\"",
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "pnpm --filter @acc/web build",
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @acc/server dev",
    "dev:web": "pnpm --filter @acc/web dev",
    "db:diff": "pnpm --filter @acc/database diff",
    "db:migrate": "pnpm --filter @acc/database migrate",
    "db:check": "pnpm --filter @acc/database check",
    "openapi": "pnpm --filter @acc/contracts openapi",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  },
  "pnpm": {
    "//": "pnpm 10 blocks postinstall scripts by default. These packages ship native binaries that are unusable without their install step: esbuild bundles the server, and Tailwind v4's oxide engine compiles the CSS. Without this list `pnpm install` succeeds but `pnpm build` fails with a confusing binary-not-found error.",
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
