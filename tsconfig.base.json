{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Required for the CommonJS packages this project depends on: `pg` and
    // `express` are both default-imported and have no ESM default export.
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@acc/domain": ["./packages/domain/src/index.ts"],
      "@acc/domain/*": ["./packages/domain/src/*"],
      "@acc/providers": ["./packages/providers/src/index.ts"],
      "@acc/providers/*": ["./packages/providers/src/*"],
      "@acc/orchestrator": ["./packages/orchestrator/src/index.ts"],
      "@acc/orchestrator/*": ["./packages/orchestrator/src/*"],
      "@acc/repositories": ["./packages/repositories/src/index.ts"],
      "@acc/repositories/*": ["./packages/repositories/src/*"],
      "@acc/database": ["./packages/database/src/index.ts"],
      "@acc/database/*": ["./packages/database/src/*"],
      "@acc/madre": ["./packages/madre/src/index.ts"],
      "@acc/madre/*": ["./packages/madre/src/*"],
      "@acc/contracts": ["./packages/contracts/src/index.ts"],
      "@acc/contracts/*": ["./packages/contracts/src/*"]
    }
  }
}
